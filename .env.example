# Copy to .env and fill in. Never commit .env.

# base64 of 32 random bytes: openssl rand -base64 32
NORTHBOT_MASTER_KEY=

# WebAuthn: the bare domain and the exact origin users open in the browser.
RP_ID=localhost
WEB_ORIGIN=http://localhost:8080

# Set to true behind HTTPS (Caddy does this in production).
COOKIE_SECURE=false
