# Copy to .env and fill in. Never commit .env.

# base64 of 32 random bytes: openssl rand -base64 32
NORTHBOT_MASTER_KEY=

# WebAuthn: the bare domain and the exact origin users open in the browser.
RP_ID=localhost
WEB_ORIGIN=http://localhost:8080

# Set to true behind HTTPS (Caddy does this in production).
COOKIE_SECURE=false

# Optional encrypted persistent agent home directories. Requires /dev/fuse on the Docker host.
# New computers only; keep the same NORTHBOT_MASTER_KEY for restore/unlock.
SANDBOX_DISK_ENCRYPTION=false
# Agent networks are carved from this /16, one /28 per agent. Change it if it clashes with your LAN.
SANDBOX_SUBNET_POOL=10.213.0.0/16
SCHEDULE_MIN_INTERVAL_S=300
