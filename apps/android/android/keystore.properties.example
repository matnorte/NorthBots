# Copy to keystore.properties (git-ignored) and fill in, or set the same values as environment
# variables NORTHBOT_KEYSTORE_FILE / NORTHBOT_KEYSTORE_PASSWORD / NORTHBOT_KEY_ALIAS / NORTHBOT_KEY_PASSWORD.
# Create a keystore once with:
#   keytool -genkeypair -v -keystore northbot-release.jks -alias northbot -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks and passwords safe: every future update must be signed with the same key.
storeFile=../northbot-release.jks
storePassword=CHANGE_ME
keyAlias=northbot
keyPassword=CHANGE_ME
