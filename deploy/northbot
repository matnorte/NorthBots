#!/usr/bin/env bash
# northbot: manage a NorthBot install.
#
#   northbot status                       Health of the server and its containers.
#   northbot backup [FILE] [--rotate N]   Database + .env (vault key) into one .tar.gz (mode 600).
#   northbot restore FILE [--database NAME] [--yes]
#                                         Into a fresh database NAME, or (default) replace the live one.
#   northbot update [--source DIR] [--health-url URL]
#                                         Rebuild and restart; rolls back automatically if health fails.
#   northbot logs [SERVICE]
#   northbot start | stop | restart       Start, stop or restart every container.
#   northbot enable | disable             Run 24/7: start on boot, self-heal every 2 minutes (systemd).
#   northbot doctor [--fix]               Diagnose the install (HTTPS, DNS, containers, AI provider...).
#   northbot set-domain HOST              Change the public domain (.env) and restart.
#
# The install folder comes from $NORTHBOT_DIR, /etc/northbot.conf, or the current folder.
set -euo pipefail

log() { printf '\033[1;35m[northbot]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[northbot] error:\033[0m %s\n' "$*" >&2; exit 1; }

if [ -z "${NORTHBOT_DIR:-}" ] && [ -f /etc/northbot.conf ]; then . /etc/northbot.conf; fi
DIR="${NORTHBOT_DIR:-$PWD}"
[ -f "$DIR/docker-compose.yml" ] || die "no NorthBot install in $DIR (set NORTHBOT_DIR)"
cd "$DIR"
if [ -f "$DIR/deploy/lib/progress.sh" ]; then
  . "$DIR/deploy/lib/progress.sh"
else
  # An older install can still use the standalone management command.
  nb_stream() { cat; }
  nb_file_bytes() { wc -c < "$1" | tr -d '[:space:]'; }
fi
if [ -f .env ]; then set -a; . ./.env; set +a; fi
FILES=(-f docker-compose.yml)
[ "${NORTHBOT_HTTPS:-false}" = true ] && FILES+=(-f deploy/docker-compose.https.yml)
compose() { docker compose --progress plain --project-directory "$DIR" "${FILES[@]}" "$@"; }
HEALTH="${NORTHBOT_HEALTH_URL:-http://127.0.0.1:3000/health}"
DB=northbot
TMPS=()
trap '[ ${#TMPS[@]} -eq 0 ] || rm -rf "${TMPS[@]}"' EXIT
IMAGES=(northbot/server:latest northbot/web:latest northbot/egress:latest northbot/agent:dev)

healthy() {
  local url="$1" tries="${2:-60}"
  local attempt
  for ((attempt=1; attempt<=tries; attempt++)); do
    curl -fsS --max-time 5 "$url" >/dev/null 2>&1 && return 0
    printf '[northbot] Waiting for readiness (%ss elapsed)\n' "$(((attempt - 1) * 2))" >&2
    sleep 2
  done
  return 1
}

# Compose does not know about the isolated networks attached dynamically for agent computers.
reconnect_egress() {
  local networks="$1" current network
  current="$(compose ps -q egress)" || return 1
  [ -n "$current" ] || return 1
  while IFS= read -r network; do
    case "$network" in nb-net-*) ;; *) continue ;; esac
    if ! docker network connect --alias egress "$network" "$current" 2> "$networks.error"; then
      # A connection may already exist, or its agent may have been removed during the update.
      grep -qiE 'already exists|already connected|No such network|network .* not found' "$networks.error" || return 1
    fi
  done < "$networks"
}

cmd_status() {
  compose ps
  if healthy "$HEALTH" 1; then log "healthy: $(curl -fsS "$HEALTH")"; else die "the server is not answering at $HEALTH"; fi
}

cmd_backup() {
  local out="" rotate=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --rotate) rotate="$2"; shift 2 ;;
      *) out="$1"; shift ;;
    esac
  done
  mkdir -p backups
  chmod 700 backups
  [ -n "$out" ] || out="backups/northbot-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
  [[ "$rotate" =~ ^[0-9]+$ ]] || die "--rotate must be a nonnegative integer"
  local tmp archive
  tmp="$(mktemp -d)"
  TMPS+=("$tmp")
  log "dumping the database"
  compose exec -T postgres pg_dump -U northbot -d "$DB" -Fc | nb_stream 0 'Database export' > "$tmp/db.dump"
  [ -s "$tmp/db.dump" ] || die "the database dump is empty"
  # The vault master key travels with the backup: without it, stored secrets cannot be read.
  [ -f .env ] && cp .env "$tmp/env"
  printf '{"format":1,"createdAt":"%s","database":"%s","bytes":%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$DB" "$(wc -c < "$tmp/db.dump")" > "$tmp/manifest.json"
  # Write privately beside the destination, then replace it atomically (including old symlinks).
  archive="$(mktemp "${out}.tmp.XXXXXX")"
  TMPS+=("$archive")
  (umask 077 && tar -czf - -C "$tmp" . | nb_stream 0 'Backup archive' > "$archive")
  chmod 600 "$archive"
  mv -f -- "$archive" "$out"
  LAST_BACKUP="$out"
  log "backup written to $out ($(du -h "$out" | cut -f1)). It contains the vault key: store it safely."
  if [ "$rotate" -gt 0 ] 2>/dev/null; then
    # Bash arrays and -nt work on BSD/macOS too and preserve embedded newlines.
    local ordered=() entry position index
    for entry in backups/northbot-*.tar.gz; do
      [ -f "$entry" ] || continue
      position=${#ordered[@]}
      for ((index=0; index<${#ordered[@]}; index++)); do
        if [ "$entry" -nt "${ordered[$index]}" ]; then position=$index; break; fi
      done
      ordered=("${ordered[@]:0:$position}" "$entry" "${ordered[@]:$position}")
    done
    for ((index=rotate; index<${#ordered[@]}; index++)); do rm -f -- "${ordered[$index]}"; done
  fi
}

cmd_restore() {
  local file="" target="$DB" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --database) target="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  [ -f "$file" ] || die "usage: northbot restore FILE [--database NAME] [--yes]"
  case "$target" in ''|postgres|template0|template1|*[!a-z0-9_]*) die "--database must name an application database using lowercase letters, digits and _" ;; esac
  local tmp
  tmp="$(mktemp -d)"
  TMPS+=("$tmp")
  # Never extract archive paths, links, ownership or permissions onto the host.
  local member
  local members='|' have_dump=0 have_env=0
  tar -tzf "$file" > "$tmp/members"
  while IFS= read -r member; do
    case "$member" in ./) continue ;; ./db.dump|./env|./manifest.json) ;;
      *) die "backup contains an unexpected archive member" ;; esac
    case "$members" in *"|$member|"*) die "backup contains a duplicate member" ;; esac
    members="$members$member|"
    [ "$member" != ./db.dump ] || have_dump=1
    [ "$member" != ./env ] || have_env=1
  done < "$tmp/members"
  [ "$have_dump" = 1 ] || die "$file is not a NorthBot backup"
  tar -xOzf "$file" ./db.dump | nb_stream 0 'Read backup' > "$tmp/db.dump"
  if [ "$have_env" = 1 ]; then tar -xOzf "$file" ./env > "$tmp/env"; fi
  [ -s "$tmp/db.dump" ] || die "$file is not a NorthBot backup"
  compose exec -T postgres pg_restore --list < "$tmp/db.dump" >/dev/null || die "invalid database dump"
  if [ -f "$tmp/env" ] && [ -f .env ]; then
    local a b
    a="$(grep '^NORTHBOT_MASTER_KEY=' "$tmp/env" || true)"
    b="$(grep '^NORTHBOT_MASTER_KEY=' .env || true)"
    [ "$a" = "$b" ] || log "warning: this backup was made with a different vault key; copy NORTHBOT_MASTER_KEY from the backup's env file into .env to read its secrets"
  fi
  if [ "$target" = "$DB" ]; then
    [ "$yes" = 1 ] || die "this replaces the live database; run again with --yes (or use --database NAME for a copy)"
    log "stopping the app"
    compose stop server egress web >/dev/null
    compose exec -T postgres dropdb -U northbot --if-exists --force "$DB"
  fi
  compose exec -T postgres createdb -U northbot "$target"
  log "restoring into database $target"
  nb_stream "$(nb_file_bytes "$tmp/db.dump")" 'Database restore' < "$tmp/db.dump" | compose exec -T postgres pg_restore -U northbot -d "$target" --no-owner --exit-on-error
  if [ "$target" = "$DB" ]; then
    compose up -d >/dev/null
    healthy "$HEALTH" 60 || die "restored, but the server is not healthy"
  fi
  log "restored $file into $target"
}

cmd_update() {
  local source="" health="$HEALTH"
  while [ $# -gt 0 ]; do
    case "$1" in
      --source) source="$2"; shift 2 ;;
      --health-url) health="$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  log "backing up before the update"
  cmd_backup
  local pre runtime img service container running path expected platform actual
  pre="$LAST_BACKUP"
  runtime="$(mktemp -d)"
  TMPS+=("$runtime")
  : > "$runtime/egress-networks"
  for path in docker-compose.yml deploy/docker-compose.https.yml deploy/Caddyfile; do
    if [ -f "$path" ]; then mkdir -p "$runtime/$(dirname "$path")"; cp "$path" "$runtime/$path"; fi
  done
  log "remembering the running images for rollback"
  for img in "${IMAGES[@]}"; do
    service="${img#northbot/}"; service="${service%%:*}"
    running="$img"
    container=""
    if [ "$service" != agent ]; then
      container="$(compose ps -q "$service")"
      if [ -n "$container" ]; then running="$(docker inspect --format '{{.Image}}' "$container")"; fi
    fi
    if [ "$service" = egress ] && [ -n "$container" ]; then
      docker inspect --format '{{range $name, $config := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$container" > "$runtime/egress-networks"
    fi
    if ! docker image inspect "$running" >/dev/null 2>&1; then
      # With Docker's containerd store, .Image can be an unaddressable config digest while
      # Compose records the platform manifest. Use a tag only after verifying that manifest.
      [ -n "$container" ] || die "cannot preserve the current $service image"
      expected="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.image"}}' "$container")"
      platform="$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$img")"
      actual="$(docker image inspect --platform "$platform" --format '{{.Id}}' "$img")"
      [ -n "$expected" ] && [ "$actual" = "$expected" ] || die "the $service tag no longer matches its running image"
      running="$img"
    fi
    docker tag "$running" "${img%%:*}:rollback"
  done
  local prepared=1
  if [ -n "$source" ]; then
    rsync -a --progress --exclude node_modules --exclude .git --exclude dist --exclude test-results --exclude .env --exclude backups --exclude first-login.txt "$source/" "$DIR/" || prepared=0
  elif [ -d .git ] && git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    git pull --progress --ff-only || prepared=0
  else
    log "no --source and no upstream branch: rebuilding the files already here"
  fi
  log "building the new version"
  if [ "$prepared" = 1 ] && compose --profile images build agent-image && compose build && compose up -d && reconnect_egress "$runtime/egress-networks" && healthy "$health" 60; then
    log "update done and healthy"
    return 0
  fi
  log "the update failed: rolling back"
  for path in docker-compose.yml deploy/docker-compose.https.yml deploy/Caddyfile; do
    if [ -f "$runtime/$path" ]; then cp "$runtime/$path" "$path"; fi
  done
  for img in "${IMAGES[@]}"; do docker tag "${img%%:*}:rollback" "$img"; done
  compose up -d --no-build --force-recreate
  reconnect_egress "$runtime/egress-networks" || die "rollback could not reconnect existing agent networks"
  if healthy "$HEALTH" 60; then
    log "rolled back to the previous version. If the database was changed, restore with: northbot restore $pre --yes"
  else
    log "the previous version is not healthy either. Restore the pre-update backup: northbot restore $pre --yes"
  fi
  return 1
}

cmd_start() {
  compose up -d --no-build
  healthy "$HEALTH" 90 || die "started, but the server is not healthy (run: northbot doctor)"
  log "running"
}

cmd_stop() { compose stop; log "stopped"; }

UNIT_DIR=/etc/systemd/system
BIN="$(command -v northbot 2>/dev/null || echo /usr/local/bin/northbot)"

cmd_enable() {
  [ -d /run/systemd/system ] || die "systemd is not running here; start NorthBot with 'northbot start' from your init system instead"
  [ "$(id -u)" = 0 ] || die "run as root: sudo northbot enable"
  systemctl enable --now docker >/dev/null 2>&1 || log "warning: could not enable the Docker service at boot"
  if [ ! -x "$BIN" ]; then
    install -m 755 "$DIR/deploy/northbot" /usr/local/bin/northbot
    printf 'NORTHBOT_DIR=%q\n' "$DIR" > /etc/northbot.conf
    BIN=/usr/local/bin/northbot
  fi
  cat > "$UNIT_DIR/northbot.service" <<EOF
[Unit]
Description=NorthBot (containers in $DIR)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=NORTHBOT_DIR=$DIR
ExecStart=$BIN start
ExecStop=$BIN stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
EOF
  cat > "$UNIT_DIR/northbot-watchdog.service" <<EOF
[Unit]
Description=NorthBot self-heal check
After=northbot.service

[Service]
Type=oneshot
Environment=NORTHBOT_DIR=$DIR
ExecStart=$BIN heal
EOF
  cat > "$UNIT_DIR/northbot-watchdog.timer" <<'EOF'
[Unit]
Description=Check NorthBot health every 2 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable northbot.service northbot-watchdog.timer >/dev/null
  systemctl start northbot.service
  systemctl start northbot-watchdog.timer
  log "NorthBot now starts on boot and heals itself every 2 minutes (journalctl -u northbot-watchdog)"
}

cmd_disable() {
  [ "$(id -u)" = 0 ] || die "run as root: sudo northbot disable"
  systemctl disable --now northbot-watchdog.timer northbot.service >/dev/null 2>&1 || true
  rm -f "$UNIT_DIR/northbot.service" "$UNIT_DIR/northbot-watchdog.service" "$UNIT_DIR/northbot-watchdog.timer"
  systemctl daemon-reload
  log "boot start and self-heal are off (containers keep running until 'northbot stop')"
}

# Run by the watchdog timer. Leaves a deliberately stopped NorthBot alone.
cmd_heal() {
  if command -v systemctl >/dev/null && systemctl list-unit-files northbot.service >/dev/null 2>&1; then
    systemctl is-active --quiet northbot.service || exit 0
  fi
  # Starts anything that exited or was removed; a no-op when everything is up.
  compose up -d --no-build >/dev/null 2>&1 || log "warning: docker compose up failed"
  if healthy "$HEALTH" 3 2>/dev/null; then exit 0; fi
  log "server unhealthy: restarting it"
  compose restart server >/dev/null
  healthy "$HEALTH" 45 2>/dev/null || { compose restart >/dev/null; log "restarted all containers"; }
}

cmd_set_domain() {
  local domain="${1:-}"
  case "$domain" in ''|-*|*.|.*|*[!a-zA-Z0-9.-]*) die "usage: northbot set-domain HOST (no scheme, port or path)" ;; esac
  [ -f .env ] || die "no .env in $DIR"
  local https="${NORTHBOT_HTTPS:-false}" origin secure
  if [ "$https" = true ]; then origin="https://$domain"; secure=true; else origin="http://$domain:8080"; secure=false; fi
  local tmp; tmp="$(mktemp "$DIR/.env.XXXXXX")"
  grep -vE '^(NORTHBOT_DOMAIN|RP_ID|WEB_ORIGIN|COOKIE_SECURE)=' .env > "$tmp" || true
  printf 'NORTHBOT_DOMAIN=%s\nRP_ID=%s\nWEB_ORIGIN=%s\nCOOKIE_SECURE=%s\n' "$domain" "$domain" "$origin" "$secure" >> "$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" .env
  log "domain set to $domain ($origin); recreating containers"
  set -a; . ./.env; set +a
  compose up -d --no-build --force-recreate
  healthy "$HEALTH" 90 || die "restarted, but the server is not healthy (run: northbot doctor)"
  log "done. Passkeys registered under the old domain will not work on the new one."
}

# ---------- doctor ----------

D_FAIL=0 D_WARN=0 D_FIX=0
ok() { printf '  \033[1;32m✔\033[0m %s\n' "$*"; }
warn() { D_WARN=$((D_WARN + 1)); printf '  \033[1;33m!\033[0m %s\n' "$*"; }
bad() { D_FAIL=$((D_FAIL + 1)); printf '  \033[1;31m✖\033[0m %s\n' "$*"; }
hint() { printf '      → %s\n' "$*"; }
section() { printf '\n\033[1m%s\033[0m\n' "$*"; }

cmd_doctor() {
  # Every check reports and moves on; one failing probe must not end the diagnosis.
  set +e +o pipefail
  [ "${1:-}" != --fix ] || D_FIX=1
  local domain="${NORTHBOT_DOMAIN:-}" https="${NORTHBOT_HTTPS:-false}"

  section "Docker"
  if docker info >/dev/null 2>&1; then ok "Docker engine is running"
  else
    bad "Docker engine is not reachable"
    if [ "$D_FIX" = 1 ] && command -v systemctl >/dev/null; then systemctl enable --now docker && ok "started Docker"; else hint "sudo systemctl enable --now docker"; fi
  fi
  if command -v systemctl >/dev/null && [ -d /run/systemd/system ]; then
    if systemctl is-enabled --quiet docker 2>/dev/null; then ok "Docker starts on boot"; else warn "Docker does not start on boot"; hint "sudo systemctl enable docker"; fi
  fi

  section "Configuration ($DIR)"
  if [ -f .env ]; then ok ".env present"; else bad ".env missing"; hint "rerun install.sh"; fi
  case "${NORTHBOT_MASTER_KEY:-}" in
    ''|ZGV2LW9ubHktbm9ydGhib3QtbWFzdGVyLWtleS0zMmI=) bad "vault master key is missing or the built-in development key" ;;
    *) ok "vault master key set" ;;
  esac
  case "$domain" in
    *example.com|*example.org|*example.net) bad "domain is the placeholder '$domain'"; hint "northbot set-domain bots.yourdomain.com" ;;
    127.*|localhost|'') if [ "$https" = true ]; then bad "HTTPS is on but the domain is '$domain'"; hint "northbot set-domain bots.yourdomain.com"; else ok "local domain '$domain' (HTTP on port 8080)"; fi ;;
    *) ok "domain $domain" ;;
  esac
  if [ "$https" = true ] && [ "${WEB_ORIGIN:-}" != "https://$domain" ]; then bad "WEB_ORIGIN (${WEB_ORIGIN:-unset}) does not match https://$domain"; hint "northbot set-domain $domain"; fi
  if [ -n "$domain" ] && [ "${RP_ID:-}" != "$domain" ]; then warn "RP_ID (${RP_ID:-unset}) differs from the domain; passkeys will fail"; hint "northbot set-domain $domain"; fi

  section "Containers"
  local services=(postgres egress server web) svc id state health policy
  [ "$https" = true ] && services+=(caddy)
  for svc in "${services[@]}"; do
    id="$(compose ps -aq "$svc" 2>/dev/null | head -n1)"
    if [ -z "$id" ]; then bad "$svc: not created"; continue; fi
    state="$(docker inspect --format '{{.State.Status}}' "$id" 2>/dev/null)"
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$id" 2>/dev/null)"
    policy="$(docker inspect --format '{{.HostConfig.RestartPolicy.Name}}' "$id" 2>/dev/null)"
    if [ "$state" != running ]; then bad "$svc: $state"
    elif [ -n "$health" ] && [ "$health" != healthy ]; then warn "$svc: running, health $health"
    else ok "$svc: running${health:+ ($health)}"; fi
    case "$policy" in always|unless-stopped) ;; *) warn "$svc: restart policy '$policy' (will not come back after a crash)"; hint "northbot update (recreates containers with restart: unless-stopped)" ;; esac
  done
  if [ "$D_FIX" = 1 ] && [ "$D_FAIL" -gt 0 ]; then compose up -d --no-build >/dev/null 2>&1 && ok "ran docker compose up -d"; fi

  section "Web and API"
  if healthy "$HEALTH" 2 2>/dev/null; then ok "API answers at $HEALTH"; else bad "API not answering at $HEALTH"; hint "northbot logs server"; fi
  if [ "${WEB_BIND:-0.0.0.0}" != 127.0.0.1 ] || [ "$https" != true ]; then
    if curl -fsS --max-time 5 -o /dev/null "http://127.0.0.1:${WEB_PORT:-8080}/"; then ok "web UI answers on port ${WEB_PORT:-8080}"; else bad "web UI not answering on port ${WEB_PORT:-8080}"; fi
  fi

  if [ "$https" = true ]; then
    section "HTTPS ($domain)"
    local resolved local_ips
    resolved="$(getent ahostsv4 "$domain" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')"
    local_ips=" $(hostname -I 2>/dev/null) "
    if [ -z "$resolved" ]; then bad "$domain does not resolve"; hint "add an A record for $domain pointing to this server's public IP, then wait a few minutes"
    else
      local ip match=0
      for ip in $resolved; do case "$local_ips" in *" $ip "*) match=1 ;; esac; done
      if [ "$match" = 1 ]; then ok "$domain resolves to this server ($resolved)"
      else warn "$domain resolves to $resolved, which is not an address on this machine (fine behind NAT/proxy)"; fi
    fi
    if command -v ss >/dev/null; then
      for port in 80 443; do
        if ss -ltnH "sport = :$port" 2>/dev/null | grep -q .; then ok "listening on port $port"; else bad "nothing listening on port $port"; fi
      done
    fi
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
      for port in 80 443; do
        ufw status 2>/dev/null | grep -qE "^($port|$port/tcp|80,443/tcp|Nginx Full|WWW Full)[[:space:]].*ALLOW" && ok "firewall allows $port" || { bad "ufw blocks port $port"; hint "sudo ufw allow $port/tcp"; }
      done
    fi
    local caddy_log
    caddy_log="$(compose logs --tail 300 caddy 2>/dev/null || true)"
    if printf '%s' "$caddy_log" | grep -q 'rejectedIdentifier\|forbidden by policy'; then bad "Let's Encrypt refuses this domain name"; hint "use a domain you own: northbot set-domain bots.yourdomain.com"; fi
    if printf '%s' "$caddy_log" | grep -qi 'NXDOMAIN\|no valid A records'; then bad "Let's Encrypt cannot find DNS records for $domain"; hint "check the A record and wait for DNS to propagate"; fi
    if printf '%s' "$caddy_log" | grep -qi 'Timeout during connect\|Connection refused\|firewall'; then bad "Let's Encrypt could not reach this server on port 80/443"; hint "open ports 80 and 443 in the VPS provider's firewall panel too"; fi
    if curl -fsS --max-time 8 -o /dev/null --resolve "$domain:443:127.0.0.1" "https://$domain/api/health"; then ok "valid certificate; https://$domain is up"
    elif curl -fsS -k --max-time 8 -o /dev/null --resolve "$domain:443:127.0.0.1" "https://$domain/api/health"; then warn "HTTPS works but the certificate is not trusted yet (Caddy may still be obtaining it)"; hint "northbot logs caddy"
    else bad "https://$domain is not answering"; hint "northbot logs caddy"; fi
  fi

  section "Running 24/7"
  if [ -d /run/systemd/system ]; then
    if systemctl is-enabled --quiet northbot.service 2>/dev/null; then ok "starts on boot (northbot.service)"; else warn "does not start on boot"; [ "$D_FIX" = 1 ] && [ "$(id -u)" = 0 ] && cmd_enable || hint "sudo northbot enable"; fi
    if systemctl is-active --quiet northbot-watchdog.timer 2>/dev/null; then ok "self-heal timer active"; else warn "self-heal timer not active"; hint "sudo northbot enable"; fi
  else warn "no systemd: start NorthBot from your init system at boot"; fi
  if command -v northbot >/dev/null; then ok "northbot command on PATH ($(command -v northbot))"
  else
    warn "northbot command is not on PATH"
    if [ "$D_FIX" = 1 ] && [ "$(id -u)" = 0 ]; then install -m 755 "$DIR/deploy/northbot" /usr/local/bin/northbot && printf 'NORTHBOT_DIR=%q\n' "$DIR" > /etc/northbot.conf && ok "installed /usr/local/bin/northbot"; else hint "sudo install -m 755 $DIR/deploy/northbot /usr/local/bin/northbot"; fi
  fi

  section "Resources and backups"
  local free_kb mem_kb latest
  free_kb="$(df -Pk "$DIR" | awk 'NR==2 {print $4}')"
  if [ "${free_kb:-0}" -lt 5242880 ]; then warn "only $((free_kb / 1024)) MB free disk"; else ok "$((free_kb / 1048576)) GB free disk"; fi
  if [ -r /proc/meminfo ]; then
    mem_kb="$(awk '/MemAvailable/ {print $2}' /proc/meminfo)"
    if [ "${mem_kb:-0}" -lt 524288 ]; then warn "only $((mem_kb / 1024)) MB memory available"; else ok "$((mem_kb / 1024)) MB memory available"; fi
  fi
  latest="$(ls -t backups/northbot-*.tar.gz 2>/dev/null | head -n1 || true)"
  if [ -z "$latest" ]; then warn "no backups yet"; hint "northbot backup"
  elif [ -n "$(find "$latest" -mmin +2880 2>/dev/null)" ]; then warn "latest backup is older than 2 days ($latest)"
  else ok "recent backup: $latest"; fi

  section "AI provider"
  local report
  report="$(compose exec -T postgres psql -U northbot -d northbot -tAc "select coalesce(json_agg(settings->'llm'), '[]') from workspaces" 2>/dev/null \
    | compose exec -T server node --input-type=module -e '
      let input = ""; for await (const c of process.stdin) input += c;
      const all = JSON.parse(input || "[]").filter(Boolean);
      if (!all.length) { console.log("WARN\tno provider configured (built-in defaults); open Settings > AI provider"); process.exit(0); }
      for (const llm of all) {
        const real = (llm.providers ?? []).filter((p) => p.type !== "fake");
        if (!real.length) console.log("WARN\tonly the demo (fake) provider is configured; open Settings > AI provider");
        console.log(`OK\tnorthbot-smart -> ${(llm.aliases?.["northbot-smart"] ?? []).join(", ") || "(none)"}`);
        for (const p of real) {
          if (!p.baseUrl) { console.log(`OK\t${p.name} (${p.type})`); continue; }
          try {
            const r = await fetch(p.baseUrl.replace(/\/$/, "") + "/models", { signal: AbortSignal.timeout(6000) });
            console.log(r.status < 500 ? `OK\t${p.name} reachable at ${p.baseUrl} (HTTP ${r.status})` : `FAIL\t${p.name} at ${p.baseUrl} answered HTTP ${r.status}`);
          } catch (e) {
            console.log(`FAIL\t${p.name} unreachable at ${p.baseUrl} from the server container (${e.cause?.code ?? e.message})`);
          }
        }
      }' 2>/dev/null || true)"
  if [ -z "$report" ]; then warn "could not read provider settings (is the server running?)"
  else
    local level msg
    while IFS=$'\t' read -r level msg; do
      case "$level" in OK) ok "$msg" ;; WARN) warn "$msg" ;; *) bad "$msg"; case "$msg" in *host.docker.internal*) hint "run 'northbot update' so the server gets the host.docker.internal mapping, and make 9router listen on 0.0.0.0" ;; esac ;; esac
    done <<< "$report"
  fi
  if command -v ss >/dev/null && ss -ltnH 'sport = :20128' 2>/dev/null | grep -qE '(0\.0\.0\.0|\*|\[::\]):20128'; then
    if ! { command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; }; then
      warn "9router (port 20128) is reachable from the internet and no firewall is active"
      hint "sudo ufw allow OpenSSH && sudo ufw allow 80,443/tcp && sudo ufw enable"
    fi
  fi

  printf '\n'
  if [ "$D_FAIL" -gt 0 ]; then printf '\033[1;31m%d problem(s)\033[0m, %d warning(s).%s\n' "$D_FAIL" "$D_WARN" "$([ "$D_FIX" = 1 ] || echo ' Try: northbot doctor --fix')"; return 1; fi
  printf '\033[1;32mAll good\033[0m (%d warning(s)).\n' "$D_WARN"
}

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  update) shift; cmd_update "$@" ;;
  logs) shift; compose logs --tail 200 -f "$@" ;;
  start) shift; cmd_start ;;
  stop) shift; cmd_stop ;;
  restart) shift; compose restart; healthy "$HEALTH" 90 && log "running" ;;
  enable) shift; cmd_enable ;;
  disable) shift; cmd_disable ;;
  heal) shift; cmd_heal ;;
  doctor) shift; cmd_doctor "$@" ;;
  set-domain) shift; cmd_set_domain "$@" ;;
  *) sed -n '2,16p' "$0"; exit 2 ;;
esac
