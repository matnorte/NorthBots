#!/usr/bin/env bash
# northbot: manage a NorthBot install.
#
#   northbot status                       Health of the server and its containers.
#   northbot backup [FILE] [--rotate N]   Database + .env (vault key) into one .tar.gz (mode 600).
#   northbot restore FILE [--database NAME] [--yes]
#                                         Into a fresh database NAME, or (default) replace the live one.
#   northbot update [--source DIR] [--health-url URL]
#                                         Rebuild and restart; rolls back automatically if health fails.
#   northbot logs [SERVICE]
#
# The install folder comes from $NORTHBOT_DIR, /etc/northbot.conf, or the current folder.
set -euo pipefail

log() { printf '\033[1;35m[northbot]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[northbot] error:\033[0m %s\n' "$*" >&2; exit 1; }

if [ -z "${NORTHBOT_DIR:-}" ] && [ -f /etc/northbot.conf ]; then . /etc/northbot.conf; fi
DIR="${NORTHBOT_DIR:-$PWD}"
[ -f "$DIR/docker-compose.yml" ] || die "no NorthBot install in $DIR (set NORTHBOT_DIR)"
cd "$DIR"
if [ -f .env ]; then set -a; . ./.env; set +a; fi
FILES=(-f docker-compose.yml)
[ "${NORTHBOT_HTTPS:-false}" = true ] && FILES+=(-f deploy/docker-compose.https.yml)
compose() { docker compose --project-directory "$DIR" "${FILES[@]}" "$@"; }
HEALTH="${NORTHBOT_HEALTH_URL:-http://127.0.0.1:3000/health}"
DB=northbot
TMPS=()
trap '[ ${#TMPS[@]} -eq 0 ] || rm -rf "${TMPS[@]}"' EXIT
IMAGES=(northbot/server:latest northbot/web:latest northbot/egress:latest northbot/agent:dev)

healthy() {
  local url="$1" tries="${2:-60}"
  for _ in $(seq 1 "$tries"); do
    curl -fsS --max-time 5 "$url" >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

cmd_status() {
  compose ps
  if healthy "$HEALTH" 1; then log "healthy: $(curl -fsS "$HEALTH")"; else die "the server is not answering at $HEALTH"; fi
}

cmd_backup() {
  local out="" rotate=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --rotate) rotate="$2"; shift 2 ;;
      *) out="$1"; shift ;;
    esac
  done
  mkdir -p backups
  chmod 700 backups
  [ -n "$out" ] || out="backups/northbot-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
  [[ "$rotate" =~ ^[0-9]+$ ]] || die "--rotate must be a nonnegative integer"
  local tmp archive
  tmp="$(mktemp -d)"
  TMPS+=("$tmp")
  log "dumping the database"
  compose exec -T postgres pg_dump -U northbot -d "$DB" -Fc > "$tmp/db.dump"
  [ -s "$tmp/db.dump" ] || die "the database dump is empty"
  # The vault master key travels with the backup: without it, stored secrets cannot be read.
  [ -f .env ] && cp .env "$tmp/env"
  printf '{"format":1,"createdAt":"%s","database":"%s","bytes":%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$DB" "$(wc -c < "$tmp/db.dump")" > "$tmp/manifest.json"
  # Write privately beside the destination, then replace it atomically (including old symlinks).
  archive="$(mktemp "${out}.tmp.XXXXXX")"
  TMPS+=("$archive")
  (umask 077 && tar -czf "$archive" -C "$tmp" .)
  chmod 600 "$archive"
  mv -f -- "$archive" "$out"
  LAST_BACKUP="$out"
  log "backup written to $out ($(du -h "$out" | cut -f1)). It contains the vault key: store it safely."
  if [ "$rotate" -gt 0 ] 2>/dev/null; then
    local kept=0 entry
    while IFS= read -r -d '' entry; do
      kept=$((kept + 1))
      if [ "$kept" -gt "$rotate" ]; then rm -f -- "${entry#* }"; fi
    done < <(find backups -maxdepth 1 -type f -name 'northbot-*.tar.gz' -printf '%T@ %p\0' | sort -z -nr)
  fi
}

cmd_restore() {
  local file="" target="$DB" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --database) target="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  [ -f "$file" ] || die "usage: northbot restore FILE [--database NAME] [--yes]"
  case "$target" in ''|postgres|template0|template1|*[!a-z0-9_]*) die "--database must name an application database using lowercase letters, digits and _" ;; esac
  local tmp
  tmp="$(mktemp -d)"
  TMPS+=("$tmp")
  # Never extract archive paths, links, ownership or permissions onto the host.
  local member
  local -A members=()
  tar -tzf "$file" > "$tmp/members"
  while IFS= read -r member; do
    case "$member" in ./) continue ;; ./db.dump|./env|./manifest.json) ;;
      *) die "backup contains an unexpected archive member" ;; esac
    [ -z "${members[$member]:-}" ] || die "backup contains a duplicate member"
    members[$member]=1
  done < "$tmp/members"
  [ -n "${members[./db.dump]:-}" ] || die "$file is not a NorthBot backup"
  tar -xOzf "$file" ./db.dump > "$tmp/db.dump"
  if [ -n "${members[./env]:-}" ]; then tar -xOzf "$file" ./env > "$tmp/env"; fi
  [ -s "$tmp/db.dump" ] || die "$file is not a NorthBot backup"
  compose exec -T postgres pg_restore --list < "$tmp/db.dump" >/dev/null || die "invalid database dump"
  if [ -f "$tmp/env" ] && [ -f .env ]; then
    local a b
    a="$(grep '^NORTHBOT_MASTER_KEY=' "$tmp/env" || true)"
    b="$(grep '^NORTHBOT_MASTER_KEY=' .env || true)"
    [ "$a" = "$b" ] || log "warning: this backup was made with a different vault key; copy NORTHBOT_MASTER_KEY from the backup's env file into .env to read its secrets"
  fi
  if [ "$target" = "$DB" ]; then
    [ "$yes" = 1 ] || die "this replaces the live database; run again with --yes (or use --database NAME for a copy)"
    log "stopping the app"
    compose stop server egress web >/dev/null
    compose exec -T postgres dropdb -U northbot --if-exists --force "$DB"
  fi
  compose exec -T postgres createdb -U northbot "$target"
  log "restoring into database $target"
  compose exec -T postgres pg_restore -U northbot -d "$target" --no-owner --exit-on-error < "$tmp/db.dump"
  if [ "$target" = "$DB" ]; then
    compose up -d >/dev/null
    healthy "$HEALTH" 60 || die "restored, but the server is not healthy"
  fi
  log "restored $file into $target"
}

cmd_update() {
  local source="" health="$HEALTH"
  while [ $# -gt 0 ]; do
    case "$1" in
      --source) source="$2"; shift 2 ;;
      --health-url) health="$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  log "backing up before the update"
  cmd_backup
  local pre runtime img service container running path expected platform actual
  pre="$LAST_BACKUP"
  runtime="$(mktemp -d)"
  TMPS+=("$runtime")
  for path in docker-compose.yml deploy/docker-compose.https.yml deploy/Caddyfile; do
    if [ -f "$path" ]; then mkdir -p "$runtime/$(dirname "$path")"; cp "$path" "$runtime/$path"; fi
  done
  log "remembering the running images for rollback"
  for img in "${IMAGES[@]}"; do
    service="${img#northbot/}"; service="${service%%:*}"
    running="$img"
    container=""
    if [ "$service" != agent ]; then
      container="$(compose ps -q "$service")"
      if [ -n "$container" ]; then running="$(docker inspect --format '{{.Image}}' "$container")"; fi
    fi
    if ! docker image inspect "$running" >/dev/null 2>&1; then
      # With Docker's containerd store, .Image can be an unaddressable config digest while
      # Compose records the platform manifest. Use a tag only after verifying that manifest.
      [ -n "$container" ] || die "cannot preserve the current $service image"
      expected="$(docker inspect --format '{{index .Config.Labels "com.docker.compose.image"}}' "$container")"
      platform="$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$img")"
      actual="$(docker image inspect --platform "$platform" --format '{{.Id}}' "$img")"
      [ -n "$expected" ] && [ "$actual" = "$expected" ] || die "the $service tag no longer matches its running image"
      running="$img"
    fi
    docker tag "$running" "${img%%:*}:rollback"
  done
  local prepared=1
  if [ -n "$source" ]; then
    rsync -a --exclude node_modules --exclude .git --exclude dist --exclude test-results --exclude .env --exclude backups --exclude first-login.txt "$source/" "$DIR/" || prepared=0
  elif [ -d .git ] && git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    git pull --ff-only || prepared=0
  else
    log "no --source and no upstream branch: rebuilding the files already here"
  fi
  log "building the new version"
  if [ "$prepared" = 1 ] && compose --profile images build -q agent-image && compose build -q && compose up -d && healthy "$health" 60; then
    log "update done and healthy"
    return 0
  fi
  log "the update failed: rolling back"
  for path in docker-compose.yml deploy/docker-compose.https.yml deploy/Caddyfile; do
    if [ -f "$runtime/$path" ]; then cp "$runtime/$path" "$path"; fi
  done
  for img in "${IMAGES[@]}"; do docker tag "${img%%:*}:rollback" "$img"; done
  compose up -d --no-build --force-recreate
  if healthy "$HEALTH" 60; then
    log "rolled back to the previous version. If the database was changed, restore with: northbot restore $pre --yes"
  else
    log "the previous version is not healthy either. Restore the pre-update backup: northbot restore $pre --yes"
  fi
  return 1
}

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  update) shift; cmd_update "$@" ;;
  logs) shift; compose logs --tail 200 -f "$@" ;;
  *) sed -n '2,14p' "$0"; exit 2 ;;
esac
